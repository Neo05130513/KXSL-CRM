# Copy to .env on the server and replace every placeholder before delivery.
KXSL_HOST=0.0.0.0
KXSL_PORT=4173
KXSL_ADMIN_USER=admin
KXSL_ADMIN_PASSWORD=replace-with-a-strong-password
KXSL_SESSION_DAYS=14

# Set to 1 when the site is opened through HTTPS.
KXSL_COOKIE_SECURE=1

# Amap Web Service key, used for geocoding and POI discovery.
AMAP_KEY=replace-with-your-amap-web-service-key
